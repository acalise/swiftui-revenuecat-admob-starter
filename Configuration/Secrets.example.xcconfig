// ─────────────────────────────────────────────────────────────────────────────
// Secrets.example.xcconfig
//
// Copy to `Secrets.xcconfig` (gitignored) and fill in what you need:
//
//     cp AppStarter/Config/Secrets.example.xcconfig AppStarter/Config/Secrets.xcconfig
//
// EVERY value is optional. With an empty file the app builds and runs end to
// end, purchases grant a local debug unlock, analytics and attribution no-op,
// ads stay off. Add a key to switch that service on. No code changes.
//
// ⚠️  These land in Info.plist inside the app bundle. Anyone can unzip an .ipa
//    and read them. Every key below is a *publishable* client key, which is why
//    that's acceptable. Never put a RevenueCat SECRET key, a PostHog PERSONAL
//    API key, or any server credential here.xcconfig keeps values out of git,
//    not out of the binary.
//
// ⚠️  xcconfig treats `//` as a comment ANYWHERE on a line, including inside a
//    value. A URL written as https://example.com silently becomes "https:".
//    Work around it with the trick below, which is why the URLs look odd.
// ─────────────────────────────────────────────────────────────────────────────

// Numeric Apple App ID: the digits in your App Store URL (…/id1234567890).
APPLE_APP_ID =

// ── RevenueCat, subscriptions ───────────────────────────────────────────────
// Dashboard → Project → API keys → *public* SDK key.
// Leave blank while building: purchases grant a local debug unlock instead, so
// the paywall and every gated feature stay testable. See docs/revenuecat.md.
REVENUECAT_API_KEY =

// Entitlement identifier, exactly as spelled in RevenueCat → Entitlements.
RC_ENTITLEMENT = pro

// Offering to show. Blank = whichever offering RevenueCat marks "current",
// which is what lets you change pricing without an app release.
RC_OFFERING =

// ── AppsFlyer, ad attribution ───────────────────────────────────────────────
// One dev key per AppsFlyer account, shared by all your apps.
// Only worth setting if you run paid ads. Read docs/launch-checklist.md BEFORE
// your first campaign: the dashboard setup is where attribution really breaks.
APPSFLYER_DEV_KEY =

// ── PostHog, product analytics ──────────────────────────────────────────────
// Project settings → Project API key (starts `phc_`). Safe to ship publicly.
POSTHOG_API_KEY =
// EU cloud: https:/​/eu.i.posthog.com, see the `//` warning above.
POSTHOG_SLASHES = //
POSTHOG_HOST = https:$(POSTHOG_SLASHES)us.i.posthog.com

// ── AdMob, ads ──────────────────────────────────────────────────────────────
// YES or NO. Google's test unit IDs are wired in, so you can turn ads on with
// no AdMob account. Serving REAL ads to yourself gets accounts banned.
ADS_ENABLED = NO

// Your app ID from AdMob → Apps → App settings: the `~` one, NOT a `/` unit ID.
// Leave as-is to use Google's public sample app ID.
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511

// Ad unit IDs (the `/` ones). Blank = Google's test units.
ADMOB_BANNER_UNIT_ID =
ADMOB_INTERSTITIAL_UNIT_ID =
ADMOB_REWARDED_UNIT_ID =

// ── App Tracking Transparency ────────────────────────────────────────────────
// YES shows Apple's IDFA prompt. Only turn it on if you spend on ads, nothing
// here needs it, and it costs a beat of trust on first launch.
// Also edit NSUserTrackingUsageDescription in Info.plist: App Review rejects
// generic wording. See Services/Tracking.swift.
ATT_ENABLED = NO

// ── Legal. App Review requires these to resolve ─────────────────────────────
SLASHES = //
TERMS_URL = https:$(SLASHES)example.com/terms
PRIVACY_URL = https:$(SLASHES)example.com/privacy
